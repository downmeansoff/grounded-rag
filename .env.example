# Postgres (docker-compose.yml поднимает контейнер с этими же значениями)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=grounded_rag
POSTGRES_USER=grounded_rag
POSTGRES_PASSWORD=grounded_rag

# Модель эмбеддингов. По умолчанию локальная, без ключа.
# Позже сюда встанет GigaEmbeddings (нужен ключ GigaChat API).
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768

# Rerank кандидатов cross-encoder'ом. Выключен по умолчанию: тянет вторую
# модель в память рядом с эмбеддером и заметно замедляет ответ.
USE_RERANK=false
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATES=30

# Contextual Retrieval: перед эмбеддингом LLM описывает место чанка в документе.
# Выключен по умолчанию: это вызов модели на каждый чанк при ingest, то есть
# единственная часть индексации, которая тратит платный ресурс. Ответы
# кэшируются на диск, повторный ingest не платит второй раз.
USE_CONTEXTUAL=false
CONTEXTUAL_CACHE_PATH=.cache/contexts.json
CONTEXTUAL_HEAD_CHARS=1200

# Ключ авторизации с developers.sber.ru (личный кабинет -> API -> GigaChat API).
# Формат: base64 строка client_id:client_secret, выдаётся порталом целиком.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
