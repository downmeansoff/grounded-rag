# Postgres (docker-compose.yml поднимает контейнер с этими же значениями)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=grounded_rag
POSTGRES_USER=grounded_rag
POSTGRES_PASSWORD=grounded_rag

# Бэкенд эмбеддингов: local (sentence-transformers, офлайн и бесплатно) или
# gigachat (сеть и платный тариф, нужен ключ ниже). Размерность у моделей
# разная, а колонка в базе заводится под конкретное число, поэтому смена
# бэкенда требует пересбора индекса: поставить EMBEDDING_DIM, удалить таблицу
# chunks, запустить ingest заново. Для gigachat это EMBEDDING_DIM=1024.
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768

# Rerank кандидатов cross-encoder'ом. Выключен по умолчанию: тянет вторую
# модель в память рядом с эмбеддером и заметно замедляет ответ.
USE_RERANK=false
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATES=30

# Contextual Retrieval: перед эмбеддингом LLM описывает место чанка в документе.
# Выключен по умолчанию: это вызов модели на каждый чанк при ingest, то есть
# единственная часть индексации, которая тратит платный ресурс. Ответы
# кэшируются на диск, повторный ingest не платит второй раз.
USE_CONTEXTUAL=false
CONTEXTUAL_CACHE_PATH=.cache/contexts.json
CONTEXTUAL_HEAD_CHARS=1200

# Ключ авторизации с developers.sber.ru (личный кабинет -> API -> GigaChat API).
# Формат: base64 строка client_id:client_secret, выдаётся порталом целиком.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Нужны только при EMBEDDING_BACKEND=gigachat. Батч это число текстов в одном
# запросе: весь корпус одним запросом слать нельзя, отказ на нём теряет прогон.
GIGACHAT_EMBEDDING_MODEL=Embeddings
GIGACHAT_EMBEDDING_BATCH=32
