# Postgres (docker-compose.yml поднимает контейнер с этими же значениями)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=grounded_rag
POSTGRES_USER=grounded_rag
POSTGRES_PASSWORD=grounded_rag

# Модель эмбеддингов. По умолчанию — локальная, без ключа.
# Позже сюда встанет GigaEmbeddings (нужен ключ GigaChat API).
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768

# Ключ авторизации с developers.sber.ru (личный кабинет -> API -> GigaChat API).
# Формат — base64 строка client_id:client_secret, выдаётся порталом целиком.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
